<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
    <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/timetable.css">
    <link rel="manifest" href="/timetableManifest.json">
</head>

<body>
    <div class="content timetableContent">
        <div class="topBtn" onclick="window.location = '/timetable/'">
            <img src="/images/svg/ArrowBack.svg" alt="">
        </div>
        <h1 class="centerSiteTitle"><%= __('When are you free')%> <%=volunteerName%>?</h1>

        <form>
            <div class="seperator"></div>
            <br>
        <h2 class="smallTitle"><%=shiftName%> <%= __('on the')%> <%=shiftDate%></h2>
<br>
            <% results.forEach(function(element) { %>
                <% if(element.freeSpots >= 1) { %>
                <input type="checkbox" id="<%= element.smallShiftId %>" class="checkbox" name="timeCheck" value="<%=element.smallShiftId %>">
            <label for="<%= element.smallShiftId %>"><%= element.shiftTime %></label><br>
            <br>
            <% } %> 
        <% }); %> 
            

            
        </form>
        <div class="button" onclick="$('form').submit()"><%= __('contiune')%></div>
        <br>
        <div id="timetableLoader" style="display: none;" class=" loader lds-ripple"><div></div><div></div></div>

    </div>
    <%- include('../../footer'); -%>

</body>
</html>
<script>
    $("form").submit(function(e) {
        e.preventDefault();
        if($('form').serializeArray() == "") return $('label').css('color', "rgb(180, 0, 0)")
        $("form").hide();
        $('.buttonContainer').hide()
        $('.centerSiteTitle').hide()
        $('.button').hide()
        $('.loader').show()
        $.ajax({
            url: '/timetable/chooseTime/',
            type: 'POST',
            cache: false,
            data: $('form').serializeArray(),
            success: function (data) {
                console.log(data.array)
                if (data.success == true) {
                    window.location = "/admin/";
                    $("form").show();
        $('.buttonContainer').show()
        $('.centerSiteTitle').show()
        $('.button').show()
        $('.loader').hide()
                }
                if (data.success == false) {
                    $(".button").show();
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function (jqXHR, textStatus, err) {
                alert('text status ' + textStatus + ', err ' + err)
                $(".button").show();
            }
        });
    })
</script>