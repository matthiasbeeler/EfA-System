<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
    <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/timetable.css">
    <link rel="manifest" href="/timetableManifest.json">
</head>

<body>
    <div class="content timetableContent">
        <h1 class="centerSiteTitle">Essen für Alle <%= __('timetable')%></h1>
        <div class="seperator"></div>
            <h2 class="smallTitle">
                29.10.2022
            </h2>
            <h2 class="smallTitle noFreeShifts" style="display: none;">
                <%= __("At the moment, there aren't any free posts available for the selected date. Thank you for you help.")%>
                
            </h2>
        <form>
            
            <h2 class="smallTitle shiftTitle">
                <%= __('free shifts')%>: <%=freeShifts%>
            </h2>
            <div class="message infoBlock" style="display: none;">
                <div class="info"></div>
            </div>
            <input type="text" name="name" placeholder="1. <%= __('name')%>" id="name" required>
            <input type="email" name="email" placeholder="2. <%= __('email address')%>" id="email" required>
            <h2 class="smallTitle"><%= __('What do you want to do')%></h2>
            <select name="shiftType" onchange="$('form').submit()" id="shiftType" required>
                <option value="" selected disabled>3. <%= __('press me')%></option>
                <% results[0].shifts.forEach(function(ele) { %>
                    <% var stop = 1; %>
                    <% ele.shifts.forEach(function(elements) { %>
                        <% if(elements.freeSpots > 0) stop = 0;%>
                        <% }); %> 
                        <% if(stop == 0){ %>

                        <option value="<%= ele.id %>"><%= ele.shiftName %></option>
                        <% }; %> 

                        
                <% }); %> 
            </select>
        </form>
        <script>
            if(document.querySelectorAll('option').length==1){
                $('form').hide()
                $('.shiftTitle').hide()
                $('.noFreeShifts').show()
            }
        </script>
        <div class="button" onclick="$('form').submit()" style="display: none;"><%= __('contiune')%></div>
        <br>
        <div class="buttonContainer">
            <div class="innerButtonContainer">
                <div class="timetableLink">
                    <img src="/images/svg/timetable/otherWeek.svg" alt="">
                </div>
                <div class="timetableLink">
                    <img src="/images/svg/timetable/signOut.svg" alt="">
                </div>
                <div class="timetableLink" onclick="window.location = '/timetable/support'">
                    <img src="/images/svg/timetable/support.svg" alt="">
                </div>
                <div class="timetableLink">
                    <img src="/images/svg/timetable/overview.svg" alt="">
                </div>
            </div>
        </div>
        <div class="locationContainer">
            <h2 class="smallTitle">
                <%= __('Our location in Seewen SZ')%>
            </h2>
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d809.4404135147449!2d8.628603349693703!3d47.03310909746644!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x478551e30b1d66c3%3A0x6a00307b01827127!2sSteinbislin%209%2C%206423%20Seewen%20SZ%2C%20Switzerland!5e0!3m2!1sen!2suk!4v1666864261641!5m2!1sen!2suk" style="border:0;width:100%;aspect-ratio: 2/1;border-radius: 10px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>

        </div>
        <div id="timetableLoader" class=" loader lds-ripple"><div></div><div></div></div>
    </div>
    <%- include('../../footer'); -%>

</body>

</html>
<script>
    var usedNames = {};
$("select > option").each(function () {
  if(usedNames[this.text]) {
     $(this).remove();
 } else {
     usedNames[this.text] = this.value;
 }});
    $('.loader').hide()
    function sub() {
        $('form').submit();
        $('.button').css('display', 'block')
    };
    $("form").submit(function(e) {
        e.preventDefault();
        if(!$("#name").val() || !$('#email')) return $(".button").show();
        $("form").hide();
        $('.buttonContainer').hide()
        $('.centerSiteTitle').hide()
        $('.button').hide()
        $('.loader').show()

        $.ajax({
            url: '/timetable',
            type: 'POST',
            cache: false,
            data: $('form').serializeArray(),
            success: function (data) {
                if (data.success == true) {
                    window.location = "/timetable/chooseTime/";
                }
                if (data.success == false) {
                    $("form").show();
                    $('.buttonContainer').show()
                    $('.centerSiteTitle').show()
                    $('.loader').hide()
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function (jqXHR, textStatus, err) {
                $("form").show();
                    $('.buttonContainer').show()
                    $('.centerSiteTitle').show()
                    $('.loader').hide()
                    $('.message').show()
                    $('.message').html("Es gab einen Fehler ("+err+")")            }
        });
    })
</script>
