<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/timetable.css">
    <link rel="manifest" href="/timetableManifest.json">
    <meta name="theme-color" content="#ececec">
</head>

<body>
    <div class="content timetableContent">
        <h1 class="centerSiteTitle">Essen für Alle <%= __('timetable')%> <%if(loc == "gr") {%>Chur<%}%> <%if(loc == "sz") {%>Seewen<%}%></h1>
        <div class="seperator"></div>
            <h2 class="smallTitle">
                <%=shiftDate%>
            </h2>
            <h2 class="smallTitle noFreeShifts" style="display: none;">
                <%= __("At the moment, there aren't any free posts available for the selected date. Thank you for you help.")%>
                
            </h2>
        <form>
            
            <h2 class="smallTitle shiftTitle">
                <%= __('free shifts')%>: <%=freeShifts%>
            </h2>
            <div class="message infoBlock" style="display: none;">
                <div class="info"></div>
            </div>
            <input type="text" name="name" value="<%=volName%>" placeholder="1. <%= __('name')%>" id="name" required>
            <input type="email" name="email" value="<%=volEmail%>" placeholder="2. <%= __('email address')%>" id="email" required>
            <h2 class="smallTitle"><%= __('What do you want to do')%></h2>
            <select name="shiftType" onchange="$('form').submit()" id="shiftType" required>
                <option value="" selected disabled>3. <%= __('press me')%></option>
                <% results[0]["shifts"+loc].forEach(function(ele) { %>
                    <% var stop = 1; %>
                    <% ele.shifts.forEach(function(elements) { %>
                        <% if(elements.freeSpots > 0) stop = 0;%>
                        <% }); %> 
                        <% if(stop == 0){ %>

                        <option value="<%= ele.id %>"><%= ele.shiftName %></option>
                        <% }; %> 

                        
                <% }); %> 
            </select>
        </form>
        <script>
            if(document.querySelectorAll('option').length==1){
                $('form').hide()
                $('.shiftTitle').hide()
                $('.noFreeShifts').show()
            }
        </script>
        <div class="button" onclick="$('form').submit()" style="display: none;"><%= __('contiune')%></div>
        <br>
        <div class="buttonContainer">
            <div class="innerButtonContainer">
                <a href="/timetable/otherWeek">
                <div class="timetableLink">
                    <img src="/images/svg/timetable/otherWeek.svg" alt="">
                </div>
            </a>
            <a href="/timetable/signOut">

                <div class="timetableLink">
                    <img src="/images/svg/timetable/signOut.svg" alt="">
                </div>
            </a>

                <a href="/timetable/support">
                <div class="timetableLink">
                    <img src="/images/svg/timetable/support.svg" alt="">
                </div>
            </a>
            <!--
            <a href="/timetable/location">
                <div class="timetableLink">
                    <img src="/images/svg/timetable/location.svg" alt="">
                </div>
            </a>
-->
            </div>
        </div>

        <div class="locationContainer">
            <h2 class="smallTitle">
                <%if(loc == "gr") {%><%= __('Our location in Chur GR')%><%}%> <%if(loc == "sz") {%><%= __('Our location in Seewen SZ')%><%}%>
                
            </h2>
            <%if(loc == "gr") {%>
                <iframe frameborder="0" scrolling="no" marginheight="0" marginwidth="0" src="https://www.openstreetmap.org/export/embed.html?bbox=9.507146179676056%2C46.85746188979569%2C9.511625468730928%2C46.85912359182533&amp;layer=mapnik&amp;marker=46.85829274723863%2C9.509385824203491" style="border:0;width:100%;aspect-ratio: 2/1;border-radius: 10px;"></iframe> 
                Grossbruggerweg 2 <br> 7000 Chur GR
                <%}%>
            <%if(loc == "sz") {%>
            <iframe frameborder="0" scrolling="no" marginheight="0" marginwidth="0" src="https://www.openstreetmap.org/export/embed.html?bbox=8.627175092697145%2C47.0323435940105%2C8.630715608596804%2C47.03402181345981&amp;layer=mapnik&amp;marker=47.03318271033194%2C8.628945350646973" style="border:0;width:100%;aspect-ratio: 2/1;border-radius: 10px;"></iframe> 
            Steinbislin 9 Seewen SZ <br>
            <a href="https://w3w.co/slime.kitchens.sofa" target="_blank">///slime.kitchens.sofa</a>
            <%}%>
        </div>
        <a href="https://nyv.ch"><img class="powered" src="/images/svg/poweredBlack.svg" alt=""></a>

        <div id="timetableLoader" class=" loader lds-ripple"><div></div><div></div></div>

    </div>
    <%- include('../../footer'); -%>

</body>

</html>
<script>
    var usedNames = {};
$("select > option").each(function () {
  if(usedNames[this.text]) {
     $(this).remove();
 } else {
     usedNames[this.text] = this.value;
 }});
    $('.loader').hide()
    function sub() {
        $('form').submit();
        $('.button').css('display', 'block')
    };
    $("form").submit(function(e) {
        e.preventDefault();
        if(!$("#name").val() || !$('#email').val()) return $(".button").show();
        $("form").hide();
        $('.buttonContainer').hide()
        $('.centerSiteTitle').hide()
        $('.button').hide()
        $('.locationContainer').hide()
        $('.loader').show()
        
        $.ajax({
            url: '/timetable',
            type: 'POST',
            cache: false,
            data: $('form').serializeArray(),
            success: function (data) {
                if (data.success == true) {
                    window.location = "/timetable/chooseTime/";
                }
                if (data.success == false) {
                    $("form").show();
                    $('.buttonContainer').show()
                    $('.centerSiteTitle').show()
                    $('.loader').hide()
                    $('.message').show()
                    $('.message').html(data.message)
                    $('.locationContainer').show()
                }
            },
            error: function (jqXHR, textStatus, err) {
                $("form").show();
                    $('.buttonContainer').show()
                    $('.centerSiteTitle').show()
                    $('.loader').hide()
                    $('.message').show()
                    $('.locationContainer').show()
          }
        });
    })
</script>
