<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/timetable.css">
    <link rel="manifest" href="/timetableManifest.json">
    <meta name="theme-color" content="#ececec">
</head>

<body>
    <div class="content timetableContent">
        <div class="topBtn" onclick="$('.content').css('opacity', '0');window.location = '/timetable/'">
            <img src="/images/svg/ArrowBackBlack.svg" alt="">
        </div>
        <h1 class="centerSiteTitle"><%= __('Sign Out')%></h1>
        <h2 class="smallTitle dateTitle">
            <%=shiftDate%>
        </h2>
        <h1 class="errorMsg message" style="display: none;">
            <%= __('No entries with these details have been found.')%>
        </h1>
        <h1 class="errorMsg delMessage" style="display: none;">
            <%= __('An error occured. Please try again in a couple of minutes.')%>
        </h1>
        <div class="seperator"></div>

        <form>

            <input type="text" name="name" placeholder="1. <%= __('name')%>" id="name" required>
            <input type="email" name="email" placeholder="2. <%= __('email address')%>" id="email" required>
            <input type="text" name="date" id="date" style="display: none;">
            <div class="button" onclick="$('form').submit()"><%= __('Search')%></div>
            <input id="submitButton" type="submit" value="" style="display: none;">
        </form>
        <div class="infoContent" style="display: none;">
            <center>
            <img src="/images/svg/infoIcon.svg" alt="">
            <h2><%=__('Please press the shift from which you wish to sign out.')%></h2>
        </center>
        </div>
        <div class="searchContent">
            <div class="titleBar">
                <div class="leftText"><%= __('Shiftname')%></div>
                <div class="centerSeperator"></div>
                <div class="rightText"><%= __('Shifttime')%></div>
            </div>


        </div>
        <div class="success" style="opacity: 0;display: none;">
            <h2 class="smallTitle"><%= __('You were signed out successfully')%></h2>
            <img src="/images/svg/timetable/timetableTick.svg" class="timetableTick" alt="">
            <div class="button successButton" id="subBtn" onclick="hideSuccess()">
                <%= __('Do you want to sign out from more shifts?')%></div>
        </div>
        <div id="timetableLoader" class=" loader lds-ripple" style="display: none;">
            <div></div>
            <div ></div>
        </div>

        <br>


    </div>
    <%- include('../../footer'); -%>

</body>

</html>
<script>
     var locations = {
        "sz": "Steinbislin 9, 6423 Seewen",
        "gr": "Planaterra 11, 7000 Chur GR",
        "gl": "Burgstrasse 26, 8750 Glarus"

    }
    function hideSuccess() {
        $('.success').hide()
        $('.success').css('opacity', "0")
        $("form").show();
        $('.buttonContainer, .dateTitle, .seperator').show()
        $('.centerSiteTitle').show()
        $('.searchContent').show()
        $('.button').show()
        $('.loader').hide()
    }

    function remove(id) {
        var shiftData = $(`#${id}`).data('shift').split(";");
        console.log(shiftData)
        $(`#${id}`).attr("onclick",
            `removeSubmit('${shiftData[0]}', '${shiftData[1]}','${shiftData[2]}','${id}')`)
        $(`#${id}`).html("<%= __('Press again to sign out')%>");
        $(`#${id}`).toggleClass('redShadowNoOffset')
    }

    function removeSubmit(shiftType, shiftTime, location, id) {
        console.log("hi")
        $("form").hide();
        $('.buttonContainer').hide()
        $('.centerSiteTitle').hide()
        $('.searchContent').hide()
        $('.button').hide()
        $('.loader').show()
        $('.infoContent').hide()
        $('.buttonContainer, .dateTitle, .seperator').hide()
        console.log(shiftType, shiftTime)
        $.ajax({
            url: '/timetable/signOut/',
            type: 'POST',
            cache: false,
            data: {
                shiftName: shiftType,
                shiftTime: shiftTime,
                location: location
            },
            success: function (data) {
                if (data.success == true) {
                    $('.loader').hide()

                    $('.success').show()
                    
                    $('.success').css('opacity', "1")
                    $('#' + id).remove()
                    if($('.searchElement').length > 0) $('.successButton').show()
                }
                if (data.success == false) {
                    $('.delMessage').show()
                    $("form").show();
                    $('.buttonContainer, .dateTitle, .seperator').show()
                    $('.centerSiteTitle').show()
                    $('.searchContent').show()
                    $('.button').show()
                    $('.loader').hide()
                }
            },
            error: function (jqXHR, textStatus, err) {

                $('.message').show()
            }
        });
    }

    $("form").submit(function (e) {
        e.preventDefault();
        if (!$("#name").val() || !$('#email')) return $(".button").show();
        $('.message').hide()
        $('.searchContent').html(`            <div class="titleBar"><div class="leftText"><%= __('Shiftname')%></div><div class="centerSeperator"></div><div class="rightText"><%= __('Shifttime')%></div></div>
`)


        $.ajax({
            url: '/timetable/signOut/search',
            type: 'POST',
            cache: false,
            data: $('form').serializeArray(),
            success: function (data) {
                console.log(data)
                if (data.success == true) {
                    var arr = data.data[0].shifts["<%=shiftDate%>"]
                    if(params.get('date')) arr = data.data[0].shifts[params.get('date')]
                    var array = Object.keys(arr)
                    var i = 0;
                    array.forEach(element => {
                        var obj =
                            `
                            <div class="shiftTile grayShadowNoOffset" id="searchElement${i}" data-shift="${arr[element].shiftName};${element};${arr[element].location}" onclick="remove('searchElement${i}')">
                    <div class="left">
                        <div class="shiftTitle">
                            ${arr[element].shiftName}
                        </div>
                        <div class="shiftTime">
                            ${element} Uhr
                        </div>
                    </div>
                    <div class="shiftTileSeperator">

                    </div>
                    <div class="right">
                        <div class="location">
                            <img src="/images/svg/location.svg" alt="">
                        </div>
                        <div class="text">
                            ${locations[arr[element].location]}
                        </div>
                    </div>
                </div>
                <div class="spacing5"></div>
                            <!--<div class="searchElement redSearchElement" id="searchElement${i}" onclick="remove('searchElement${i}')"><div class="leftText text">${arr[element].shiftName}</div><div class="centerSeperator"></div><div class="rightText text">${element}</div><div class="emailText text" style="display: none;"></div><img src="/images/svg/delete.svg" alt=""></div>-->`
                        i++;
                        $('.searchContent').append(obj)
                    });
                    if(i > 0) $('.infoContent').show()

                }
                if (data.success == false) {
                    $('.message').show()
                    if(data.message = "date"){
                        $('.content').css('opacity', '0');window.location = '/timetable/otherWeek?red=true'
                    }
                }
            },
            error: function (jqXHR, textStatus, err) {

                $('.message').show()
            }
        });
    })
    const params = new URLSearchParams(location.search);
    document.querySelector('#name').value = params.get('name');
    document.querySelector('#email').value = params.get('email');
    document.querySelector('#date').value = params.get('date');
    if(params.get('date')) $('.dateTitle').html(params.get('date'))
    if(params.get('email')) $('#submitButton').click()
</script>