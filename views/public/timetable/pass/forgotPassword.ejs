<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EfA-Pass password forgotten</title>
    <link rel="stylesheet" href="/stylesheets/pass.css?v=1">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
</head>
<body>

    <div class="content">
        <div class="backButton grayShadowNoOffset" onclick="window.location = '/timetable/pass/'">
            <img class="svgWhite" src="/images/svg/back.svg" alt="">
        </div>
        <div class="spacing5"></div>
        <div class="topTitle">
            <%=__('Password forgotten')%>

        </div>
        <div class="spacing10"></div>

        <form class="loginForm">
            <div class="errorMessage redShadowNoOffset message" style="display: none;">
                <center>
                    <div class="messageText">
                        Error: please enter all your details.
                    </div>
                </center>
            </div>
            <div class="spacing5"></div>
            <input type="text" id="input" required name="input" onchange="$(this).css('border', 'none');"
                oninvalid="$(this).css('border', '2px solid red');" placeholder="<%= __("E-mail")%>"
                class="standardInput">
                <div class="spacing5"></div>
          

            <input type="submit" class="submitButton button grayInnerShadowNoOffset submit" value="<%=__('Send reset-link')%>">
        </form>
        <div class="spacing10"></div>
       <div class="successMessage" style="display: none;">
        <img src="/images/svg/tickRound.svg" alt="">
        <div class="successText">
            <%=__('If this e-mail address is registered in our system, a password reset-link will be sent shortly.')%>
        </div>
       </div>

    </div>
    <%- include('../../../footer'); -%>

</body>

</html>
<script>
    var errorMessages = ["", "<%= __('Please fill out all fields.')%>", "<%= __('An error occured. Try again.')%>",
        "<%= __('Incorrect Username and/or Password!')%>", "<%= __('Account not active. Contact support.')%>"
    ]
    $("form").submit(function (e) {
        e.preventDefault();
        $('.errorMessage').hide()
        $(".submit").val("<%= __('Loading...')%>")
        $('.submit').prop('disabled', true);
        try {
            $.ajax({
                url: '/timetable/pass/passwordForgotten',
                type: 'POST',
                cache: false,
                data: {
                    "input": $('#input').val(),
                },
                xhrFields: {
                    withCredentials: true
                },
                crossDomain: true,
                success: function (data, status, xhr) {
                    if (data) {

                        if (data.success == true) {
                            $(".submit").addClass(`successButton`)
                            $("form").hide()
                            $('.successMessage').show()
                        }
                        if (data.success == false) {
                            $('.errorMessage').show()
                            $('.errorMessage .messageText').html(data.message)
                            $(".submit").val("<%= __('Login')%>")
                            $('.submit').prop('disabled', false);
                            if (data.error == 0) {
                                $('.errorMessage').show()
                                $('.errorMessage .messageText').html(
                                    "<%= __('Too many requests were made. Please wait ')%>" +
                                    data.time + "<%= __(' minutes')%>")
                            }
                        }
                    }

                },
                error: function (jqXHR, textStatus, err) {
                    $('.errorMessage').show()
                    $('.errorMessage .messageText').html("<%= __('An error occerd whilst communication with our server.')%>")

                    $(".submit").val("<%= __('Login')%>")
                    $('.submit').prop('disabled', false);
                }
            });


        } catch (error) {
            $('.errorMessage').show()
            $('.errorMessage .messageText').html("<%= __('An error occerd whilst communication with our server.')%>")
            $(".submit").val("<%= __('Login')%>")
            $('.submit').prop('disabled', false);
        }
    })
</script>