<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your EfA-Pass</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/pass.css?v=13">
    <link rel="manifest" href="/timetableManifest.json">
    <script src="//cdnjs.cloudflare.com/ajax/libs/moment.js/2.17.1/moment.min.js"></script>
</head>

<body>
    <div class="content">
        <div class="accountIcon" onclick="window.location = '/timetable/pass/settings'">
            <img src="/images/svg/accountIcon.svg" alt="">
        </div>
        <div class="container greenShadowNoOffset">
            <div class="containerTopContent">
                <div class="logo">
                    <img src="/images/svg/logo.svg" alt="">
                </div>
                <div class="topText">
                    <div class="name">
                        <%=tokenData.name%>
                    </div>
                    <div class="email">
                        <%=tokenData.email%>
                    </div>
                </div>
            </div>
            <div class="bottomContent">
                <div class="profileImage">
                    <div class="imageContainer" style="background-image: url('/timetable/pass/uploads/profileImages/<%=tokenData.id%>.webp?v=<%=Math.floor(Math.random() * 9999)%>');">
                    </div>
                </div>
                <div class="qrCode">
                    <img src="<%=qrCode%>" alt="">
                </div>
            </div>
        </div>
            <div style="display: none;" class="profilePicMessage container wideContainer messageContainer grayShadowNoOffset">
               <div class="title noMarginTitle"><%=__("You dont have a profile picture set yet.")%></div><img src="/images/svg/cancelRound.svg" onclick="localStorage.setItem('profilePicMessageHidden', 1); $('.profilePicMessage').remove()" alt="">
               <div class="info"><%=__('Simply add a profile picture by clicking on the account-icon on the right top of your screen and then on "Profile image".')%></div>
            </div>
        <div class="smallTitle title">
            <%=__('Upcoming shifts')%>
        </div>
        <div class="noShifts" style="display: none;">
            <div class="container wideContainer messageContainer grayShadowNoOffset">
                <div class="title noMarginTitle"><%=__("You aren't registered for any upcoming shifts at the moment.")%></div>
                <div class="info"><%=__('Simply press on "Register for new shift" below to register for an upcoming shift.')%></div>
             </div>
        </div>
        <div class="dateContainer">
            
        </div>
        <div class="spacing10"></div>
        <div class="spacing10"></div>

        <div class="addNewShiftContainer">
            <div class="newShiftButton greenShadowNoOffset" onclick="$('.content').css('opacity', '0'); window.location = '/timetable'">
                <img src="/images/svg/addIcon.svg" alt="">
                <div class="text"><%=__('Register for new shifts')%></div>
            </div>
        </div>

    </div>
</body>

</html>

<script>
    var locations = {
        "sz": "Steinbislin 9, 6423 Seewen",
        "gr": "Planaterra 11, 7000 Chur GR"
    }
    var shiftData =<%-JSON.stringify(shiftData) %>;
    var start = moment('2023-03-02'), // Sept. 1st
        end = moment('2025-11-02'), // Nov. 2nd
        day = 6;                    // Sunday

    var result = [];
    var current = start.clone();

    while (current.day(7 + day).isBefore(end)) {
        result.push(current.clone());
    }

    var saveSat = result.map(m => m.format('YYYY-MM-DD'));
    saveSatDone = []
    saveSat.forEach(function (element) {
        if (!moment(element).isBefore(moment().subtract(1, 'days'))) { saveSatDone.push(element) }
    })
    saveSatDone = saveSatDone.slice(0, 8)
    saveSatDone.forEach(element => {
        if (shiftData.shifts[element.split('-')[2] + "." + element.split('-')[1] + "." + element.split('-')[0]]) {
            var data = shiftData.shifts[element.split('-')[2] + "." + element.split('-')[1] + "." + element.split('-')[0]];
            var date = element.split('-')[2] + "." + element.split('-')[1] + "." + element.split('-')[0];

            if(Object.keys(data).length){
                var showDate = date;
                if(date == moment().format('DD.MM.YYYY')) showDate = "<%=__('Today')%>";
            var obj = ` <div class="dateTitle title">
            ${showDate}
        </div>
        <div class="shiftContainer ${element}"></div> 
        <div class="spacing5"></div>
`;
            $('.dateContainer').append(obj)
            addElements(data, element)
    }
        }
    });
    function addElements(data, date) {
        for (var key in data) {
            
            var obj = ` 
            <div class="spacing5"></div>
            <div class="shiftTile grayShadowNoOffset">
                    <div class="left">
                        <div class="shiftTitle">
                            ${data[key].shiftName}
                        </div>
                        <div class="shiftTime">
                            ${key} Uhr
                        </div>
                    </div>
                    <div class="seperator">

                    </div>
                    <div class="right">
                        <div class="location">
                            <img src="/images/svg/location.svg" alt="">
                        </div>
                        <div class="text">
                            ${locations[data[key].location]}
                        </div>
                    </div>
                </div>
            `;
            $('.'+date).append(obj)
        }
    }
</script>

<script defer>
                if(!localStorage.getItem('profilePicMessageHidden') && !shiftData.profilePictureUpdate) $('.profilePicMessage').show()
    if($('.dateContainer').children().length == 0) $('.noShifts').show()
</script>