<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EfA-Pass</title>
    <link rel="stylesheet" href="/stylesheets/pass.css?v=2">
    <link rel="manifest" href="/timetableManifest.json">
    <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogoPass.png">
    <meta name="theme-color" content="#ececec">
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    <script src="/javascripts/jquery.min.js"></script>
    <script>
        if (typeof navigator.serviceWorker !== 'undefined') {
          navigator.serviceWorker.register('/sw.js')
        }
      </script>
</head>
<body>

    <div class="content">
        <div class="topLogo">
            <img src="/images/svg/efaTopLogo.svg" alt="">
        </div>
        <div class="spacing5"></div>
        <div class="topTitle topLogoTitle">
            Essen für Alle <%= __('timetable')%>
        </div>
        <div class="spacing5"></div>
        <div class="errorMessage formError redShadowNoOffset message" style="display: none;">
            <center>
                <div class="messageText">
                </div>
            </center>
        </div>
        <div class="spacing5"></div>
            <input type="submit" onclick="window.location = '/timetable/pass/login'" class="submitButton button grayInnerShadowNoOffset" value="<%=__('Login')%>">
            <div class="spacing5"></div>
            <input type="submit" onclick="window.location = '/timetable/pass/signup'" class="submitButton button grayInnerShadowNoOffset" value="<%=__('Sign up')%>">
            <div class="spacing5"></div>
            
            <input type="submit" onclick="guest()" class="submitButton button grayInnerShadowNoOffset mainContinueButton" value="<%=__('Continue as guest')%>">
        <div class="spacing10"></div>
        <center>

            <div onclick="window.location = '/timetable/support'"><a><%= __('Contact us')%></a></div>
        </center>
    </div>
    <%- include('../../../footer'); -%>

</body>

</html>

<script>
    function guest(){
        $.ajax({
            url: '/timetable/pass/guest',
            type: 'POST',
            cache: false,
            success: function (data) {
                if (data.success == true) {
                    window.location = "/timetable/";
                }
                if (data.success == false) {
                    $(".button").show();
                    $('.formError').show()
                    $('.formError').html("An error occured. Please try again.")
                }
            },
            error: function (jqXHR, textStatus, err) {
                $(".button").show();
                $('.formError').show()
                $('.formError').html('text status ' + textStatus + ', err ' + err)
            }
        });
    }
</script>