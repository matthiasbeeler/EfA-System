<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<script>
    function Check(){
        var test = new RegExp('(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9])(?=.{8,})')
       if(test.test($('#password').val())){
        $('.noCrit').hide()
        $('#password').css('border', '2px solid green')
        return true;
       }else{
        $('.noCrit').show()
        $('#password').css('border', '2px solid red')
        return false;
       }
    }
    function matchCheck(){
        var test = new RegExp('(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9])(?=.{8,})')
       if($('#password').val() == $('#passwordCheck').val()){
        $('.noMatch').hide()
        $('#passwordCheck').css('border', '2px solid green')
        $('#password').css('border', '2px solid green')
        return true;
       }else{
        $('.noMatch').show()
        $('#password').css('border', '2px solid red')
        $('#passwordCheck').css('border', '2px solid red')
        return false;
       }
    }
    if (typeof navigator.serviceWorker !== 'undefined') {
    navigator.serviceWorker.register('/javascript/pwabuilder-sw.js')
  }
</script>
<body>
    <div class="content">
        <div class="topBtn" onclick="window.location = '/'">
            <img src="/images/svg/ArrowBack.svg" alt="">
        </div>
        <form>
            <div class="message infoBlock">
                <div class="info"></div>
            </div>
            <input type="text" name="username" placeholder="Benutzername" id="" required>
            <input type="text" name="name" placeholder="Voller Name" id="" required>
            <input type="text" name="email" placeholder="E-Mail" id="" required>
            <input type="password" onchange="Check()" name="password" placeholder="Passwort" id="password" required>
            <div class="successMsg passwordRequirements infoBlock noCrit" style="display: none;">
                Dein Passwort sollte folgende Kriterien befolgen
                <list>
                    <li>Es sollte mindestens 8 Zeichen lang sein.</li>
                    <li>Es sollte mindestens ein Grossbuchstabe beinhalten.</li>
                    <li>Es sollte mindestens ein Kleinbuchstabe beinhalten.</li>
                    <li>Es sollte mindestens eine Zahl beinhalten.</li>
                    <li>Es sollte mindestens ein Sonderzeichen beinhalten.</li>
                </list>
            </div>
            <input type="password" onchange="matchCheck()" name="" placeholder="Passwort wiederholen" id="passwordCheck" required>
            <div class="successMsg passwordRequirements noMatch infoBlock" style="display: none;">
                Deine Passwörter stimmen nicht überein.
            </div>
        </form>
        <p class="centerText">Mit der Registration akzeptieren Sie die unsere <a href="https://www.essenfueralle.org/kartensystem/reglement/" target="_blank" >Regeln</a></p>
        <div class="button" onclick="$('form').submit()">Registrieren</div>
    </div>
    <%- include('../footer'); -%>

</body>

</html>
<script>
    $('.message').hide()
    $("form").submit(function(e) {
        e.preventDefault();
        if($('#password').val() !== $('#passwordCheck').val()) return $('.message').html("Die Passwörter stimmen nicht überein")
        $(".button").hide();
        $.ajax({
            url: '/register',
            type: 'POST',
            cache: false,
            data: $('form').serializeArray(),
            success: function (data) {
                console.log(data)
                if (data.success == true) {
                    window.location = "/";
                }
                if (data.success == false) {
                    $(".button").show();
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function (jqXHR, textStatus, err) {
                alert('text status ' + textStatus + ', err ' + err)
                $(".button").show();
            }
        });
    })
</script>