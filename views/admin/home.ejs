<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
    <link rel="stylesheet" href="/stylesheets/main.css?v=1">
    <link rel="manifest" href="/manifest.json">
</head>
<body>
    <div class="content">
        <div class="toptitle title homeTitle">
            <% if(location == "gr"){%>
                Chur GR
                <%}%>
                <% if(location == "gl"){%>
                    Glarus
                    <%}%>
                <% if(location == "sz"){%>
                    Seewen SZ
                    <%}%>
                    <% if(location == "zh"){%>
                        Zürich
                        <%}%>
            
          </div>
        
    <div class="button buttonImage actionButton logout blockButton buttonRight" onclick="window.location = '/admin/logout'"><img src="/images/svg/logout.svg" alt="" >Logout</div>
    <div class="tiles">
        <% if(permissions.receiverRegistration){%>
        <div class="receiverRegistration tile button" onclick="window.location = '/admin/receiverRegistration'">
            <div class="title">Bezügerregistration</div>
            <img src="/images/svg/receiverRegistration.svg" alt="">
        </div>
        <%}%>
        <% if(permissions.receiverMaintenance){%>
        <div class="receiverMaintenance tile button" onclick="window.location = '/admin/receiverMaintenance'">
            <div class="title">Bezügerverwaltung</div>
            <img src="/images/svg/receiverMaintenance.svg" alt="">
        </div>
        <%}%>
        <% if(permissions.entry){%>
        <div class="entry tile button" onclick="window.location = '/admin/entry'">
            <div class="title">Eingang</div>
            <img src="/images/svg/entry.svg" alt="">
        </div>
        <%}%>
        <% if(permissions.volunteerCards){%>
            <div class="entry tile button" onclick="window.location = '/admin/volunteers/volunteerCards'">
                <div class="title">Freiwilligenkarten</div>
                <img src="/images/svg/badge.svg" alt="">
            </div>
            <%}%>
        <% if(permissions.statistics){%>
            <div class="entry tile button" onclick="window.location = '/admin/statistics'">
                <div class="title">Statistik</div>
                <img src="/images/svg/statistics.svg" alt="">
            </div>
            <%}%>
            <% if(permissions.volunteers){%>
                <div class="receiverRegistration tile button" onclick="window.location = '/admin/volunteers'">
                    <div class="title">Freiwilligenverwaltung</div>
                    <img src="/images/svg/volunteers.svg" alt="">
                </div>
                <%}%>
        <% if(permissions.accounts){%>
        <div class="receiverRegistration tile button" onclick="window.location = '/admin/accounts'">
            <div class="title">Accountverwaltung</div>
            <img src="/images/svg/adminUser.svg" alt="">
        </div>
        <%}%>
        <% if(permissions.print){%>
            <div class="receiverRegistration tile button" onclick="window.location = '/admin/print'">
                <div class="title">Print cards</div>
                <img src="/images/svg/print.svg" alt="">
            </div>
            <%}%>
    </div>
</div>
<%- include('../footer'); -%>

</body>
</html>

<script>
    if (typeof navigator.serviceWorker !== 'undefined') {
    navigator.serviceWorker.register('/javascripts/pwabuilder-sw.js')
  }
</script>