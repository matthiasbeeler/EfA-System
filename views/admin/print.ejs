<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
<script>
    url = new URL(window.location.href);
    const queryString = window.location.search;
    const urlParams = new URLSearchParams(queryString);

    if (!url.searchParams.has('timeslot')) {
        $('.e210_2').css('display', "none")
        $('.printButton').css('display', "none")
        $('form').css('display', "block")
    }
    if (url.searchParams.has('timeslot')) {
        var timeslot = urlParams.get('timeslot');
        var colour = ""
        if (timeslot == "11:00-12:00") colour = "#FF7878"
        if (timeslot == "12:00-13:00") colour = "#8DA6FF"
        if (timeslot == "13:00-14:00") colour = "#1ED300"
        if (timeslot == "14:00-15:00") colour = "#FD99FF"
        if (timeslot == "15:00-16:00") colour = "#FFEA7A"
        var colourShapes = ["e1306_2", "e1306_7", "e1306_15", "e1306_23", "e1306_31", "e1306_39", "e1306_47", "e1306_55", "e1306_63"]
        var time = ["e210_65", "e1306_8", "e1306_16", "e1306_24", "e1306_32", "e1306_40", "e1306_48", "e1306_56", "e1306_64"]
        colourShapes.forEach(element => {
            $(`.${element}`).css('background-color', `${colour}`)
        });
        time.forEach(element => {
            var timeslotNice = timeslot.split('-').join(" - ")
            $(`.${element}`).html(timeslotNice)
            $(`.${element}`).css('font-weight', `bold`)
        });
        $('form').css('display', "none")

        $('.e1220_5').html('12312')

        $.ajax({
            url: '/admin/print/getData',
            type: 'POST',
            cache: false,
            success: function (data) {
                window.matchMedia("print").addListener(function () {
                    $.ajax({
                        url: '/admin/print/setId',
                        type: 'POST',
                        cache: false,
                        data: {
                            id: data.startId + 9
                        },
                        success: function (data) {
                        },
                        error: function (jqXHR, textStatus, err) {
                            alert('text status ' + textStatus + ', err ' + err)
                            $('#msg').html("fatal_error_sys_down")
                            $('body').css('background', '#f08080');

                        }
                    })

                })
                var startId = data.startId + 1;
                var countNum = 0;
                var qrContainers = ["e1306_5", "e1306_13", "e1306_21", "e1306_29", "e1306_37", "e1306_45", "e1306_53", "e1306_61", "e1306_69"]
                var numContainers = ["e1220_5", "e1306_11", "e1306_19", "e1306_27", "e1306_35", "e1306_43", "e1306_51", "e1306_59", "e1306_67"]
                qrContainers.forEach(element => {
                    var entitlement = "A"
                    if (countNum > 5) var entitlement = "B"

                    new QRCode(document.querySelector(`.${qrContainers[countNum]}`), { text: String(`{"id":"${startId + countNum}", "timeslot":"${timeslot}", "entitlement": "${entitlement}", "location":"sz"}`), correctLevel: QRCode.CorrectLevel.L });
                    $(`.${numContainers[countNum]}`).html(startId + countNum)
                    countNum++;
                });
            },
            error: function (jqXHR, textStatus, err) {
                alert('text status ' + textStatus + ', err ' + err)
                $('#msg').html("fatal_error_sys_down")
                $('body').css('background', '#f08080');

            }
        })

    }
</script>