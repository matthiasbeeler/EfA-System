<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Essen für Alle</title>
  <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
  <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
  <link rel="stylesheet" href="/stylesheets/main.css?v=1">
  <link rel="manifest" href="/manifest.json">
</head>

<body>
  <div class="content">
    <div class="topBtn" onclick="window.location = '/admin/'">
      <img src="/images/svg/ArrowBack.svg" alt="">
    </div>

    <div class="overlay checkInScanOverlay overlayBig">
      <div id="checkInScanReader"
        style="margin-top: 10%;margin-left: 6.5%; overflow: hidden;width: 87%; height: fit-content; position: relative; padding: 0px; border-radius: 10px;">
      </div>
      <div class="button" onclick="hideCheckInScanScanner()">Abbrechen</div>
    </div>
    <div class="button buttonImage preRegBtn" onchange="$(this).css('border', '2px solid white');"
      onclick="checkInScan()"><img src="/images/svg/qrScan.svg" alt="">Check-in</div>
    <div class="checkInOverlay">
      <center>
        <div class="checkInOverlayInner infoBlock successInner">
          <img src="/images/svg/greenTick.svg" alt="Green tick">
          <div class="infoName">
            ${volunteerName}
          </div>
          <div class="info searchContent">
            <div class="searchElement">
              <div class="leftText text">${shiftTime}</div>
              <div class="centerSeperator"></div>
              <div class="rightText text">${shiftType}</div>
            </div>
            <div class="searchElement">
              <div class="leftText text">${shiftTime}</div>
              <div class="centerSeperator"></div>
              <div class="rightText text">${shiftType}</div>
            </div>

          </div>
          <div class="button" onclick="$(this).parent().parent().parent().hide()">Ausblenden</div>
        </div>
        <div class="checkInOverlayInner infoBlock errorInner">
          <img src="/images/svg/redCross.svg" alt="Red cross">
          <div class="infoName">
            Es wurden keine Daten gefunden.
          </div>
          <div class="button" onclick="$(this).parent().parent().parent().hide()">Ausblenden</div>

        </div>
      </center>
    </div>
    <br>
    <br>
    <select onchange="pickDate()" name="date" id="" class="date">
      <option value="" selected disabled>Bitte Datum auswählen</option>
    </select>
    <br>
    <br>
    <!--<div class="centerSiteTitle"><%=session.shiftDate%> (<%-location %>)</div>-->
    <div style="display: none;" class="noData centerSiteTitle">Für das gewählte Datum sind keine Daten verfügbar.</div>

    <div class="innerContent">
      <div class="shiftList">

      </div>
    </div>
    <!--<div class="button buttonImage fixedButton" onchange="$(this).css('border', '2px solid white');"
    onclick="window.location = '/admin/volunteers/lookup'">Freiwilligensuche</div>-->
    <div class="tick">
      <img src="/images/svg/greenTick.svg" alt="">
    </div>
    <div class="loader">
      <img src="/images/svg/loader.svg" alt="">
    </div>
    <br>
  </div>

</body>

</html>
<script src="/javascripts/qr.min.js"></script>
<script>
  $('.message').hide()
  $('.checkInScanOverlay').hide() 
  var shiftData = undefined;
  <%if (shiftData) {%>
       shiftData = <%-shiftData %>;
      <% } %>
  var volunteerData = <%-volunteerData %>;
  if(shiftData ==undefined) $('.noData').show();
  if(shiftData !==undefined) {
    if(shiftData["shifts<%-location %>"] == null)$('.noData').show();
  }

  shiftData["shifts<%-location %>"].forEach(element => {
    var shiftName = element.shiftName;
    var ObjMain = `<div class="infoBlock ${shiftName}"><div class="infoName">${shiftName}</div></div>`;
    $('.shiftList').append(ObjMain)
    element.shifts.forEach(shift => {
    var volunteerDiv = "";
      $.each(shift.volunteers, function(is, item) {
        $.each(volunteerData, function(i, item) {
          if(item.id == is) volunteerDiv = volunteerDiv+`<li>${item.name}</li>`
        })
      })
      var freeSpots = "Freie Schichten: "+shift.freeSpots
      var ObjInner =
        `<div class="infoBlock"><div class="infoName">${shift.shiftTime}</div><div class="info">${volunteerDiv}</div><br><div class="smallInfo">${freeSpots}</div></div>`;
      $('.' + shiftName).append(ObjInner)
    })
  });
</script>
<script>
  var datesArray = <%-JSON.stringify(datesArray.slice(0,4))%>;
  datesArray.forEach(element => {
    $('.date').append(`<option value="${element}">${element} (<%-location.toUpperCase() %>)</option>`)
  });
  $('.date').val("<%=session.shiftDate%>");


function pickDate() {
  window.location = "/admin/volunteers?date="+ $('.date').val();
}


  function hideCheckInScanScanner() {
    $('.checkInScanOverlay').hide();
    checkInScanScanner.stop();
  }

  function checkInScan() {
    console.log("hi")
    checkInScanScanner.start({
      facingMode: "environment"
    }, config, checkInScanSuccess);
    $('.checkInScanOverlay').show()
  }

  const checkInScanScanner = new Html5Qrcode("checkInScanReader");
  const config = {
    fps: 30,
    qrbox: {
      width: 200,
      height: 200
    },
  };


  function checkInScanSuccess(decodedText, decodedResult) {
    try {
    checkInScanScanner.stop()
    $('.checkInScanOverlay').hide();
    $.ajax({
      url: '/admin/volunteers/checkIn',
      type: 'POST',
      cache: false,
      data: {
        id: JSON.parse(decodedText).id
      },
      success: function (data) {
        if (data.success == true) {
          $('.checkInOverlay, .checkInOverlay .successInner').show();
          $('.checkInOverlay .successInner .infoName').html(data.name);
          $('.checkInOverlay .successInner .searchContent').html("");
          var array = Object.keys(data.dateData)
          var i = 0;
          array.forEach(element => {
            var obj =
              `<div class="searchElement" ><div class="leftText text">${element}</div><div class="centerSeperator"></div><div class="rightText text">${data.dateData[element].shiftName}</div></div>`
            i++;
            $('.checkInOverlay .successInner .searchContent').append(obj)
          });
        }
        if (data.success == false) {
          $('.checkInOverlay, .checkInOverlay .errorInner').show();
          if(data.message) {
            $('.checkInOverlay .errorInner .infoName').html(data.message);
          }
        }
      }
    })
  } catch (error) {
      console.log(error)
    }
  }


  $('.message').hide()
  $("#form").submit(function (e) {
    e.preventDefault();
    if (!entitlementSelect()) return;
    $('form').hide();

    $('.loader').show()

    $(".button").hide();
    $.ajax({
      url: '/admin/receiverRegistration/',
      type: 'POST',
      cache: false,
      data: $('form').serializeArray(),
      success: function (data) {
        console.log(data)
        if (data.success == true) {
          $('.loader').hide()

          $('form').hide();
          $('.button').hide();
          $('.tick').show()
          setTimeout(() => {
            window.location.href = "/admin/";
          }, 1000);
        }
        if (data.success == false) {
          if (data.receiverId) {
            $('.loader').hide()

            $(".button").show();
            $('form').show();

            $('.message').show()
            $('.message').html("Einzelne Bezügerdaten wurden bereits gefunden.")
            $('.message').append(
              `<div class="button" onclick="window.open('/admin/receiverMaintenance/${data.receiverId}', '_blank');">BezügerIn anzeigen</div>`
              )
          }
          $('form').show();

          $(".button").show();
          $('.message').show()
          $('.message').html(data.message)
          $('.loader').hide()

        }
      },
      error: function (jqXHR, textStatus, err) {
        alert('text status ' + textStatus + ', err ' + err)
        $(".button").show();
      }
    });
    
      
 
  })

</script>