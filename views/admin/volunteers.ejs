<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
    <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/main.css">
    <link rel="manifest" href="/manifest.json">
</head>

<body>
    <div class="content">
        <div class="topBtn" onclick="window.location = '/admin/'">
            <img src="/images/svg/ArrowBack.svg" alt="">
        </div>
        <div class="button buttonImage checkinBtn" onclick="checkinScan()"><img src="/images/svg/qrScan.svg"
                alt="">Check-in</div>
        <div class="overlay preRegOverlay overlayBig">
            <div id="preRegReader"
                style="margin-top: 10%;margin-left: 6.5%; overflow: hidden;width: 87%; height: fit-content; position: relative; padding: 0px; border-radius: 10px;">
            </div>
            <div class="button" onclick="hideCheckinScanner()">Abbrechen</div>
        </div>
        <div class="tick">
            <img src="/images/svg/greenTick.svg" alt="">
        </div>
        <div class="loader">
            <img src="/images/svg/loader.svg" alt="">
        </div>
        <br>
    </div>

</body>

</html>
<script src="/javascripts/qr.min.js"></script>
<script>
    $('.message').hide()
    $('.preRegOverlay').hide()
    $('.cardScanOverlay').hide()

    function hideCheckinScanner() {
        $('.preRegOverlay').hide();
        checkin.stop();
    }

    function checkinScan() {
        checkin.start({
            facingMode: "environment"
        }, config, preRegScanSuccess);
        $('.preRegOverlay').show()
    }
    const checkin = new Html5Qrcode("preRegReader");
    const cardScanScanner = new Html5Qrcode("cardScanReader");
  const config = {
    fps: 30,
    qrbox: {
      width: 200,
      height: 200
    },
  };
</script>