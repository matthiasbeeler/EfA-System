<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>

<body>
    <div class="content">
        <div class="topBtn" onclick="window.location = '/admin/volunteers/volunteerCards/administration'">
            <img src="/images/svg/ArrowBack.svg" alt="">
        </div>
        <div class="toptitle title">
            FW-Karten Hinzufügen
        </div>

        <form>
            <div class="message infoBlock">
                <div class="info"></div>
            </div>
            <input type="text" name="name" placeholder="Voller Name" id="" required>
            <input type="text" name="id" placeholder="Karten-ID" id="" required>
            <img src="/images/FwCardExample.png" style="margin-top:10%;width: 70%; margin-left: 15%;" alt="">
            <textarea name="comment" placeholder="Bemerkungen" id="" cols="30" rows="2"></textarea>

        </form>
        <div class="button" onclick="$('form').submit()">Hinzufügen</div>
        <div class="tick">
            <img src="/images/svg/greenTick.svg" alt="">
          </div>
          <div class="loader">
            <img src="/images/svg/loader.svg" alt="">
          </div>
    </div>

</body>

</html>
<script>
    $('.message').hide()
    $("form").submit(function (e) {
        e.preventDefault();
        $('form').hide();
        $('.loader').show()
        $(".button").hide();
        $(".button").hide();
        $.ajax({
            url: '/admin/volunteers/volunteerCards/addNew',
            type: 'POST',
            cache: false,
            data: $('form').serializeArray(),
            success: function (data) {

                if (data.success == true) {
                    $('.loader').hide()

                    $('form').hide();
                    $('.button').hide();
                    $('.tick').show()
                    setTimeout(() => {
                        window.location = "/admin/volunteers/volunteerCards/administration";
                    }, 1000);
                }
                if (data.success == false) {
                    $(".button").show();
                    $('form').show();
                    $('.loader').hide()
                    $(".button").show();
                    $(".button").show();
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function (jqXHR, textStatus, err) {
                alert('text status ' + textStatus + ', err ' + err)
                $(".button").show();
            }
        });
    })
</script>