<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Essen für Alle</title>
  <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
  <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
  <link rel="stylesheet" href="/stylesheets/main.css?v=1.0.0.2">
  <link rel="manifest" href="/manifest.json">
</head>

<body>
  <div class="content">
    <div class="topBtn" onclick="window.location = '/admin/';">
      <img src="/images/svg/ArrowBack.svg" alt="">
    </div>
    <div class="toptitle title">
      Freiwilligenkarten
    </div>
    <div class="infoBlock message entryMessage">

    </div>
    <div class="overlaySmall cardScanOverlay">
      <div id="cardScanReader"
        style="margin-top: 10%;margin-bottom: 5%;margin-left: 6.5%; overflow: hidden;width: 87%; height: fit-content; position: relative; padding: 0px; border-radius: 10px;">
      </div>
    </div>
    <div class="checkInOverlay">
      <center>
        <div class="checkInOverlayInner infoBlock successInner">
          <img src="/images/svg/greenTick.svg" alt="Green tick">
          <div class="infoName">
            ${volunteerName}
          </div>
          <div class="info searchContent">
            <div class="searchElement">
              <div class="leftText text">${shiftTime}</div>
              <div class="centerSeperator"></div>
              <div class="rightText text">${shiftType}</div>
            </div>
            <div class="searchElement">
              <div class="leftText text">${shiftTime}</div>
              <div class="centerSeperator"></div>
              <div class="rightText text">${shiftType}</div>
            </div>

          </div>
          <div class="button" onclick="window.location.reload()">Ausblenden</div>
        </div>
        <div class="checkInOverlayInner infoBlock errorInner">
          <img src="/images/svg/redCross.svg" alt="Red cross">
          <div class="infoName">
            Es wurden keine Daten gefunden.
          </div>
          <div class="button" onclick="window.location.reload()">Ausblenden</div>

        </div>
      </center>
    </div>
    <div class="button buttonImage" onclick="window.location = '/admin/volunteers/volunteerCards/manual';"><img
        src="/images/svg/manual.svg" alt="">Manuelle Eingabe</div>
    <br>
    <div class="button buttonImage" onclick="window.location = '/admin/volunteers/volunteerCards/administration';"><img
        src="/images/svg/volunteersSmall.svg" alt="">Verwaltung</div>

<br>

    <br>
    <br>
    <div class="button specButton" onclick="scan()">Bestätigen</div>

    <br>
  </div>
</body>

</html>
<script src="/javascripts/qr.min.js"></script>
<script>
  $('.message').hide()
  $('.cardScanOverlay').hide()
  $('.specButton').hide()


  const cardScanScanner = new Html5Qrcode("cardScanReader");
  const config = {
    fps: 30,
    qrbox: {
      width: 200,
      height: 200
    },
  };

  cardScanScanner.start({
    facingMode: "environment"
  }, config, cardScanSuccess);
  $('.cardScanOverlay').show()

  function scan() {
    $(".button").show();
    $('.specButton').hide()
    $('.message').hide()
    $('.cross').hide()
    cardScanScanner.start({
      facingMode: "environment"
    }, config, cardScanSuccess);
    $('.cardScanOverlay').show()

  }

  function cardScanSuccess(decodedText, decodedResult) {
    $('.button').hide()
    $('.message').hide()
    $('.cardScanOverlay').hide()
    cardScanScanner.stop().then((ignore) => {
      
      $.ajax({
        url: '/admin/volunteers/volunteerCards/',
        type: 'POST',
        cache: false,
        data: {
          id: JSON.parse(decodedText).id
        },
        success: function (data) {
          console.log(data)
          if (data.success == true) {
            $('.button').show()

            $('.checkInOverlay, .checkInOverlay .successInner').show();
          $('.checkInOverlay .successInner .infoName').html(data.name);
          $('.checkInOverlay .successInner .searchContent').html(data.message);

          }
          if (data.success == false) {
            $('.button').show()
          $('.checkInOverlay, .checkInOverlay .errorInner').show();
          if(data.message) {
            $('.checkInOverlay .errorInner .infoName').html(data.message);
          }
        }
        },
        error: function (jqXHR, textStatus, err) {
          alert('text status ' + textStatus + ', err ' + err)
          $(".button").show();
        }
      });

    }).catch((err) => { });
  }


</script>