<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
    <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/main.css">
    <link rel="manifest" href="/manifest.json">
</head>

<body>
    <div class="content">
        <div class="topBtn" onclick="window.location = '/admin/'">
            <img src="/images/svg/ArrowBack.svg" alt="">
        </div>
<div class="button buttonImage preRegBtn" onclick="preRegScan()"><img src="/images/svg/qrScan.svg" alt="">Vorregistration</div>
<div class="overlay preRegOverlay overlayBig">
    <div id="preRegReader" style="margin-top: 10%;margin-left: 6.5%; overflow: hidden;width: 87%; height: fit-content; position: relative; padding: 0px; border-radius: 10px;"></div>
    <div class="button" onclick="hidePreRegScanner()">Abbrechen</div>
  </div>
  <div class="overlay cardScanOverlay overlayBig">
    <div id="cardScanReader" style="margin-top: 10%;margin-left: 6.5%; overflow: hidden;width: 87%; height: fit-content; position: relative; padding: 0px; border-radius: 10px;"></div>
    <div class="button" onclick="hideCardScanScanner()">Abbrechen</div>
  </div>
        <form id="form">
            <div class="message infoBlock">
                <div class="info"></div>
            </div>
            <input type="tel" onchange="$(this).css('border', '2px solid white');" name="phonenumber" placeholder="Telefonnummer" id="phonenumber" oninvalid=" $(this).css('border', '2px solid red');" required>
            <select name="permit" onchange="$(this).css('border', '2px solid white');" id="passportType" oninvalid=" $(this).css('border', '2px solid red');" required>
                <option value="" disabled selected>Aufenthaltsstatus</option>
                <option value="s">S</option>
                <option value="F">F</option>
                <option value="B">B</option>
                <option value="C">C</option>
                <option value="CH">CH</option>
                <option value="Sans papier">Sans papier</option>
                <option value="N">N</option>
                <option value="L">L</option>
            </select>
            <input type="text" onchange="$(this).css('border', '2px solid white');" name="passportnumber" maxlength="20" placeholder="Ausweisnummer" id="" oninvalid=" $(this).css('border', '2px solid red');" required>
            <input type="text" onchange="$(this).css('border', '2px solid white');" name="birthdate" placeholder="Geburtsdatum DD.MM.YYY" required pattern="[0-9]{2}.[0-9]{2}.[0-9]{4}" oninvalid=" $(this).css('border', '2px solid red');" required>
            <input type="text" onchange="$(this).css('border', '2px solid white');" name="name" placeholder="Vorname, Nachname" id="name" oninvalid=" $(this).css('border', '2px solid red');" required>
            <select name="gender" onchange="$(this).css('border', '2px solid white');" id="gender" oninvalid=" $(this).css('border', '2px solid red');" required>
                <option value="" disabled selected>Geschlecht</option>
                <option value="Weiblich">Weiblich</option>
                <option value="Männlich">M&auml;nnlich</option>
                <option value="Anderes">Anderes</option>
            </select>
            <select name="familymembers" onchange="$(this).css('border', '2px solid white');" id="familyMembers" oninvalid=" $(this).css('border', '2px solid red');" required>
                <option value="" disabled selected>Zusätzliche Familienmitglieder</option>
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
                <option value="6">6</option>
                <option value="7">7</option>
                <option value="8">8</option>
                <option value="9">9</option>
                <option value="10">9</option>
                <option value="11">9</option>

            </select>
            <input type="text" name="postalcode" onchange="$(this).css('border', '2px solid white');" placeholder="Postleitzahl" id="postalCode" required oninvalid=" $(this).css('border', '2px solid red');">
            <div class="button buttonImage" onchange="$(this).css('border', '2px solid white');" onclick="cardScan()"><img src="/images/svg/qrScan.svg" alt="">Karte einscannen</div>
            <input type="number" max="9999999" onchange="$(this).css('border', '2px solid white');" name="cardid" id="cardID" placeholder="Karten-ID" id="" required oninvalid=" $(this).css('border', '2px solid red');">
            <select name="entitlement" id="entitlement" onchange="$(this).css('border', '2px solid white');" class="smallSelect" id="" oninvalid=" $(this).css('border', '2px solid red');" required>
                <option value="" disabled selected>Berechtigung</option>
                <option value="A">A</option>
                <option value="B">B</option>
            </select>
            <select name="timeslot" id="timeslot" onchange="$(this).css('border', '2px solid white');" class="smallSelect" id="" required oninvalid=" $(this).css('border', '2px solid red');">
                <option value="" disabled selected>Timeslot</option>
                <option value="11:00-12:00">11:00-12:00</option>
                <option value="12:00-13:00">12:00-13:00</option>
                <option value="13:00-14:00">13:00-14:00</option>
                <option value="14:00-15:00">14:00-15:00</option>
                <option value="15:00-16:00">15:00-16:00</option>

            </select>
            <div id="inputs">

            </div>
            <textarea name="comments" placeholder="Bemerkungen" id="" cols="30" rows="2"></textarea>
            <button type="submit" class="button">Registrieren</button>
        </form>
        <div class="tick">
          <img src="/images/svg/greenTick.svg" alt="">
        </div>
        <br>
    </div>
</body>

</html>
<script src="/javascripts/qr.min.js"></script>
<script>
      $('.message').hide()
      $('.preRegOverlay').hide()
      $('.cardScanOverlay').hide()

    function hidePreRegScanner() {
    $('.preRegOverlay').hide();
    preReg.stop();
  }
  function preRegScan(){
    preReg.start({
    facingMode: "environment"
  }, config, preRegScanSuccess);
  $('.preRegOverlay').show()
  }
  function hideCardScanScanner() {
    $('.cardScanOverlay').hide();
    cardScanScanner.stop();
  }
  function cardScan(){
    cardScanScanner.start({
    facingMode: "environment"
  }, config, cardScanSuccess);
  $('.cardScanOverlay').show()
  }

    const preReg = new Html5Qrcode("preRegReader");
    const cardScanScanner = new Html5Qrcode("cardScanReader");
  const config = {
    fps: 30,
    qrbox: {
      width: 200,
      height: 200
    },
  };
  

  function preRegScanSuccess(decodedText, decodedResult) {
    console.log(decodedText)
    preReg.stop()
      $('.preRegOverlay').hide();
      console.log(JSON.parse(decodedText).id)
      $.ajax({
            url: '/admin/receiverRegistration/preReg',
            type: 'POST',
            cache: false,
            data: {
              id: JSON.parse(decodedText).id
            },
            success: function (data) {
              console.log(data)
                if (data.success == true) {
                    var results = data.results[0];
                    $('#inputs').html(`<input type="text" name="id" placeholder="ReceiverId" required="" value="${results.id}" style="display: none;" readonly>`)
                    $('#name').val(results.fullName);
                    $('#name').css("border", "2px solid white");
                    $('#phonenumber').val(results.phonenumber);
                    $('#phonenumber').css("border", "2px solid white");
                    $('#passportType').val(results.passportType);
                    $('#passportType').css("border", "2px solid white");
                    $('#familyMembers').val(results.familyMembers);
                    $('#familyMembers').css("border", "2px solid white");
                    $('#postalCode').val(results.postalCode);
                    $('#postalCode').css("border", "2px solid white");
                    $('#gender').val(results.gender);
                    $('#gender').css("border", "2px solid white");
                }
                if (data.success == false) {
                    $('.message').show()
                    $('.info').html("Keine Daten konnten geladen werden.")
                }
            },
            error: function (jqXHR, textStatus, err) {
                alert('text status ' + textStatus + ', err ' + err)
                $(".button").show();
            }
        });
          
  }
  function cardScanSuccess(decodedText, decodedResult) {
    $('.cardScanOverlay').hide()
    cardScanScanner.stop().then((ignore) => {
        $('#cardID').val(JSON.parse(decodedText).id)
        $('#cardID').css("border", "2px solid white");
        $('#timeslot').val(JSON.parse(decodedText).timeslot)
        $('#timeslot').css("border", "2px solid white");
        $('#entitlement').val(JSON.parse(decodedText).entitlement)
        $('#entitlement').css("border", "2px solid white");

    }).catch((err) => {});
  }


    $('.message').hide()
    $("#form").submit(function(e) {
        e.preventDefault();
        $(".button").hide();
        $.ajax({
            url: '/admin/receiverRegistration/',
            type: 'POST',
            cache: false,
            data: $('form').serializeArray(),
            success: function (data) {
                console.log(data)
                if (data.success == true) {
                  $('form').hide();
                  $('.button').hide();
                  $('.tick').show()
                  setTimeout(() => {
                    window.location.href = "/admin/";
                  }, 1000);
                }
                if (data.success == false) {
                  if(data.receiverId){
                    $(".button").show();
                    $('.message').show()
                    $('.message').html("Einzelne Bezügerdaten wurden bereits gefunden.")
                    $('.message').append(`<div class="button" onclick="window.location = '/admin/receiverMaintenance/${data.receiverId}'">BezügerIn anzeigen</div>`)
                  }
                    $(".button").show();
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function (jqXHR, textStatus, err) {
                alert('text status ' + textStatus + ', err ' + err)
                $(".button").show();
            }
        });
    })
</script>