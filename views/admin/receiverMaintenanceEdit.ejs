<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
    <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/main.css?v=1.1">
    <link rel="manifest" href="/manifest.json">
</head>

<body>
    <div class="content wideContent">
        <div class="topBtn" onclick="window.location = document.referrer">
            <img src="/images/svg/ArrowBack.svg" alt="">
        </div>
        <div class="toptitle title">
          <%-result[0].fullName%>
      </div>

  <div class="overlay cardScanOverlay overlayBig">
    <div id="cardScanReader" style="margin-top: 10%;margin-left: 6.5%; overflow: hidden;width: 87%; height: fit-content; position: relative; padding: 0px; border-radius: 10px;"></div>
    <div class="button" onclick="hideCardScanScanner()">Abbrechen</div>
  </div>
        <form id="form">
      <button type="submit" class="saveBtn button buttonImage"><img src="/images/svg/save.svg" alt=""> Speichern</button>

            <div class="message infoBlock">
                <div class="info"></div>
            </div>
            <input type="tel" value="<%-result[0].phonenumber%>" onchange="$(this).css('border', '2px solid white');" name="phonenumber" placeholder="Telefonnummer" id="phonenumber" oninvalid=" $(this).css('border', '2px solid red');" required>
            <select name="permit" value="<%-result[0].passportType%>" onchange="$(this).css('border', '2px solid white');" id="passportType" oninvalid=" $(this).css('border', '2px solid red');" required>
                <option value="" disabled selected>Aufenthaltsstatus</option>
                <option value="S">S</option>
                <option value="F">F</option>
                <option value="B">B</option>
                <option value="C">C</option>
                <option value="CH">CH</option>
                <option value="Sans papier">Sans papier</option>
                <option value="N">N</option>
                <option value="L">L</option>
            </select>
           
            <input type="text" value="<%-result[0].fullName%>" onchange="$(this).css('border', '2px solid white');" name="name" placeholder="Vorname, Nachname" id="name" oninvalid=" $(this).css('border', '2px solid red');" required>
            <select name="gender" value="<%-result[0].gender%>" onchange="$(this).css('border', '2px solid white');" id="gender" oninvalid=" $(this).css('border', '2px solid red');" required>
                <option value="" disabled selected>Geschlecht</option>
                <option value="Weiblich">Weiblich</option>
                <option value="Männlich">M&auml;nnlich</option>
                <option value="Anderes">Anderes</option>
            </select>
           
            <input type="text" value="<%-result[0].postalCode%>" name="postalcode" onchange="$(this).css('border', '2px solid white');" placeholder="Postleitzahl" id="postalCode" required oninvalid=" $(this).css('border', '2px solid red');">
            <div class="infoBlock">
              <input type="text" onchange="$(this).css('border', '2px solid white');reload = false;" class="passportnumber" name="passportnumber"
                maxlength="20" placeholder="Ausweis- oder Zemisnummer" id="" value="<%-result[0].passportNumber%>"
                oninvalid=" $(this).css('border', '2px solid red');" required>
                <input inputmode="decimal" name="birthdate" value="<%-result[0].birthdate%>" id="dateField" type="text" class="dateField" placeholder="DD.MM.YYYY Geburtsdatum"
                required onchange="$(this).css('border', '2px solid white');"
                oninvalid=" $(this).css('border', '2px solid red');" pattern="[0-9]{2}.[0-9]{2}.[0-9]{4}">
              </div>
            <br>

              <div class="zemis">
                <div class="sideTitle">Weitere Familienmitglieder</div>
                <div class="inputContainer">
        
                </div>
                <div class="removeZemis" onclick="addZemis()">Person hinzufügen</div>
              </div>
              <input type="text" class="selectButtonInput family noBorderInput" onfocus="$(this).blur();" onclick="$(this).blur();" value="Familienmitglieder: 1"
                onchange="$(this).css('border', '2px solid white');reload = false;" name="familyMembers" id="familyMembers"
                oninvalid=" $(this).css('border', '2px solid red');" required>

            <div class="button buttonImage" onchange="$(this).css('border', '2px solid white');" onclick="cardScan()"><img src="/images/svg/qrScan.svg" alt="">Karte einscannen</div>
            <input type="number" value="<%-result[0].cardId%>" max="9999999" onchange="$(this).css('border', '2px solid white');" inputmode="decimal" name="cardid" id="cardID" placeholder="Karten-ID" id="" required oninvalid=" $(this).css('border', '2px solid red');">
            <select name="entitlement" id="entitlement" onchange="$(this).css('border', '2px solid white');" class="smallSelect" id="" oninvalid=" $(this).css('border', '2px solid red');" required>
                <option value="" disabled selected>Berechtigung</option>
                <option value="A">A</option>
                <option value="B">B</option>
            </select>
            <select name="timeslot" id="timeslot" onchange="$(this).css('border', '2px solid white');" class="smallSelect" id="" required oninvalid=" $(this).css('border', '2px solid red');">
              <option value="" disabled selected>Timeslot</option>
              <option value="11:00-12:00">11:00-12:00</option>
              <option value="12:00-13:00">12:00-13:00</option>
              <option value="13:00-14:00">13:00-14:00</option>
              <option value="14:00-15:00">14:00-15:00</option>
              <option value="15:00-16:00">15:00-16:00</option>
            </select>
            <div id="inputs">

            </div>
            <select name="paid" id="paid" onchange="$(this).css('border', '2px solid white');" class="smallSelect" id="" required oninvalid=" $(this).css('border', '2px solid red');">
              <option value="1" selected>Bezahlt</option>
              <option value="0">Unbezahlt</option>
          </select>
            <select name="blocked" id="blocked" onchange="$(this).css('border', '2px solid white');" class="smallSelect" id="" required oninvalid=" $(this).css('border', '2px solid red');">
              <option value="0">Nicht blockiert</option>
              <option value="1">Blockiert</option>
          </select>
            <textarea name="comment" placeholder="Bemerkungen" id="" cols="30" rows="2"><%-result[0].comment%></textarea>
            
            <button type="submit" class=" saveBtn button buttonImage"><img src="/images/svg/save.svg" alt=""> Speichern</button>
            <div class="searchContent">
              <div class="infoBlock">
              <div class="infoName">Essensbezüge
              </div>
          </div>
              <div class="titleBar"><div class="leftText">Uhrzeit</div><div class="centerSeperator"></div><div class="rightText">Datum</div></div>
          <% logResults.forEach(function(result) { %>
              <div class="searchElement"><div class="leftText text"><%-result.logTime%></div><div class="centerSeperator"></div><div class="rightText text"><%-result.date%></div></div>
          <% }); %> 
      </div>
          </form>
        
        <div class="tick">
          <img src="/images/svg/greenTick.svg" alt="">
        </div>
        <br>
    </div>
</body>

</html>
<script src="/javascripts/qr.min.js"></script>
<script>

$('#blocked').val("<%-result[0].blocked%>")
$('#paid').val("<%-result[0].paid%>")
$('#passportType').val("<%-result[0].passportType%>")
$('#gender').val("<%-result[0].gender%>")
$('#familyMembers').val("Familienmitglieder: <%-result[0].familyMembers%>")
$('#timeslot').val("<%-result[0].timeslot%>")
$('#entitlement').val("<%-result[0].entitlement%>")
console.log($('#familyMembers').val())
      $('.message').hide()
      $('.cardScanOverlay').hide()
      var ZemisCounter = 1;

    var zemis = <%-zemisData%>;
    if(zemis.length > 1){
      zemis.forEach(element => {
        if(element.zemisNr == "<%-result[0].passportNumber%>"){
    $('.passportnumber').val(element.zemisNr)
          return;
        }

     
      reload = false;
    var obj =
      `
      <div class="infoBlock">
        <input type="text" onchange="$(this).css('border', '2px solid white');reload = false;" name="name${ZemisCounter}"
        placeholder="Vorname, Nachname" id="name" oninvalid=" $(this).css('border', '2px solid red');" value="${element.name}">
      <input type="text" onchange="$(this).css('border', '2px solid white');reload = false;" name="passportnumber${ZemisCounter}"
        maxlength="20" placeholder="Ausweis- oder Zemisnummer" value="${element.zemisNr}" id=""
        oninvalid=" $(this).css('border', '2px solid red');">
        <input inputmode="decimal" name="birthdate${ZemisCounter}" id="dateField" type="text" class="dateField" placeholder="DD.MM.YYYY Geburtsdatum"
       onchange="$(this).css('border', '2px solid white');" value="${element.birthdate}"
        oninvalid=" $(this).css('border', '2px solid red');" pattern="[0-9]{2}.[0-9]{2}.[0-9]{4}">
        <div class="removeZemis" onclick="removeZemis(this)">L&ouml;schen</div>
      </div>`;
    $('.inputContainer').append(obj);
    ZemisCounter++;
    $('#familyMembers').val('Familienmitglieder: '+ZemisCounter);
    });
    }

    setTimeout(() => {
      if(document.querySelectorAll('.infoBlock').length-1 !== <%-result[0].familyMembers%>){
        for (let index = document.querySelectorAll('.infoBlock').length-1; index < <%-result[0].familyMembers%>; index++) {
          addZemis();
          
        }
      }
    }, 300);
    
    function addZemis() {
    reload = false;
    var obj =
      `
      <div class="infoBlock">
        <input type="text" onchange="$(this).css('border', '2px solid white');reload = false;" name="name${ZemisCounter}"
        placeholder="Vorname, Nachname" id="name" oninvalid=" $(this).css('border', '2px solid red');">
      <input type="text" onchange="$(this).css('border', '2px solid white');reload = false;" name="passportnumber${ZemisCounter}"
        maxlength="20" placeholder="Ausweis- oder Zemisnummer" id=""
        oninvalid=" $(this).css('border', '2px solid red');">
        <input inputmode="decimal" name="birthdate${ZemisCounter}" id="dateField" type="text" class="dateField" placeholder="DD.MM.YYYY Geburtsdatum"
       onchange="$(this).css('border', '2px solid white');"
        oninvalid=" $(this).css('border', '2px solid red');" pattern="[0-9]{2}.[0-9]{2}.[0-9]{4}">
        <div class="removeZemis" onclick="removeZemis(this)">L&ouml;schen</div>
      </div>`;
    $('.inputContainer').append(obj);
    ZemisCounter++;
    $('#familyMembers').val('Familienmitglieder: '+ZemisCounter);
  };
    function removeZemis(that){
      ZemisCounter--;
    $(that).parent().remove()
    $('#familyMembers').val('Familienmitglieder: '+ZemisCounter);
    }
  function hideCardScanScanner() {
    $('.cardScanOverlay').hide();
    cardScanScanner.stop();
  }
  function cardScan(){
    cardScanScanner.start({
    facingMode: "environment"
  }, config, cardScanSuccess);
  $('.cardScanOverlay').show()
  }

    const cardScanScanner = new Html5Qrcode("cardScanReader");
  const config = {
    fps: 30,
    qrbox: {
      width: 200,
      height: 200
    },
  };

  function cardScanSuccess(decodedText, decodedResult) {
    $('.cardScanOverlay').hide()
    cardScanScanner.stop().then((ignore) => {
        $('#cardID').val(JSON.parse(decodedText).id)
        $('#cardID').css("border", "2px solid white");
        $('#timeslot').val(JSON.parse(decodedText).timeslot)
        $('#timeslot').css("border", "2px solid white");
        $('#entitlement').val(JSON.parse(decodedText).entitlement)
        $('#entitlement').css("border", "2px solid white");

    }).catch((err) => {});
  }

    $('.message').hide()
    $("#form").submit(function(e) {
        e.preventDefault();
        $(".button").hide();
        $('form').hide()
        $.ajax({
            url: '/admin/receiverMaintenance/<%-result[0].id%>/edit/',
            type: 'POST',
            cache: false,
            data: $('form').serializeArray(),
            success: function (data) {
                console.log(data)
                if (data.success == true) {
                  $('form').hide();
                  $('.button').hide();
                  $('.tick').show()
                  $('.message').show()
                  $('.message').addClass("successMessage")

                    $('.message').html("Daten gespeichert.")
                  setTimeout(() => {
                    $('form').show();
                    $('.button').show();
                    $('.tick').hide()
                  }, 2000);
                  setTimeout(() => {
                    $('.message').hide()
                    $('.message').html("Daten gespeichert.")
                    $('.message').removeClass("successMessage")

                  }, 5000);
                }
                if (data.success == false) {
                  if(data.receiverId){

                    $(".button").show();
                    $('form').show();

                    $('.message').show()
                    $('.message').html("Einzelne Bezügerdaten wurden bereits gefunden.")
                    $('.message').append(`<div class="button" onclick="window.open('/admin/receiverMaintenance/${data.receiverId}', '_blank');">BezügerIn anzeigen</div>`)
                  }
                  $('form').show();

                    $(".button").show();
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function (jqXHR, textStatus, err) {
                alert('text status ' + textStatus + ', err ' + err)
                $(".button").show();
            }
        });
    })
</script>

<script> //datepicker
  var el = document.getElementById("dateField");

  el.onkeyup = function (evt) {
    if ((evt.keyCode >= 48 && evt.keyCode <= 57) || (evt.keyCode >= 96 &&
        evt.keyCode <= 105)) {
      evt = evt || window.event;

      var size = document.getElementById('dateField').value.length;

      if ((size == 2 && document.getElementById('dateField').value > 31) || (size == 5 && Number(document
          .getElementById('dateField').value.split('.')[1]) > 99) || (size >= 10 && Number(document.getElementById(
          'dateField').value.split('.')[2]) > 2023)) {
        
        return;
      }

      if ((size == 2 && document.getElementById('dateField').value < 32) || (size == 5 && Number(document
          .getElementById('dateField').value.split('.')[1]) < 99)) {
        document.getElementById('dateField').value += '.';
      }

    } else {
    }
  }
</script>