<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>

<body>
    <div class="content">
        <div class="topBtn" onclick="window.location = '/admin/receiverMaintenance/'">
            <img src="/images/svg/ArrowBack.svg" alt="">
        </div>

        <div class="toptitle title">
            <%-result[0].fullName%>
        </div>
            <div class="button unblockButton buttonImage" onclick="unblock()" style="display: none;"><img src="/images/svg/tick.svg" alt="">Freischalten</div>
        <div class="infoBlock">

            <div class="infoName">Telefonnummer
            </div>
        <div class="info"><%-result[0].phonenumber%></div>
    </div>
    <div class="infoBlock">

<div class="infoName">Ausweisnummer
</div>
<div class="info"><%-result[0].passportNumber%></div>
</div>
<div class="infoBlock">

    <div class="infoName">Aufenthaltsstatus
    </div>
    <div class="info"><%-result[0].passportType%></div>
    </div>
    <div class="infoBlock">

        <div class="infoName">Geburtsdatum
        </div>
        <div class="info"><%-result[0].birthdate%></div>
        </div>
        <div class="infoBlock">

            <div class="infoName">Geschlecht
            </div>
            <div class="info"><%-result[0].gender%></div>
        </div>

            <div class="infoBlock">

                <div class="infoName">Zustätzliche Familienmitglieder
                </div>
                <div class="info"><%-result[0].familyMembers%></div>
                </div>
                <div class="infoBlock">

                    <div class="infoName">Postleitzahel / Ort
                    </div>
                    <div class="info"><%-result[0].postalCode%></div>
                    </div>

                    <div class="infoBlock">

                        <div class="infoName">Karten-ID
                        </div>
                        <div class="info"><%-result[0].cardId%></div>
                        </div>

                        <div class="infoBlock">

                            <div class="infoName">Timeslot
                            </div>
                            <div class="info"><%-result[0].timeslot%></div>
                            </div>
                            <div class="infoBlock">

                                <div class="infoName">Bezugsberechtigung
                                </div>
                                <div class="info"><%-result[0].entitlement%></div>
                            </div>

                                <div class="infoBlock">

                                    <div class="infoName">Bemerkungen
                                    </div>
                                    <div class="info"><%-result[0].comment%></div>
                                </div>

                                    <% if(result[0].blocked == 0){%>
                                        <div class="infoBlock">

                                            <div class="infoName">Nicht blockiert
                                            </div>
                                        </div>
                                        <% }else{%>
                                            <div class="infoBlock">

                                                <div class="infoName"> Blockiert
                                                </div>
                                            </div>
                                            <% }%>
                                            <% if(result[0].activeRegistration == 1){%>
                                                <div class="infoBlock">
        
                                                    <div class="infoName">Aktiv
                                                    </div>
                                                </div>
                                                <% }else{%>
                                                    <div class="infoBlock">
        
                                                        <div class="infoName"> Inaktiv
                                                        </div>
                                                    </div>
                                                    <% }%>

</div>
</body>


</html>