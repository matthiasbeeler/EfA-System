<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>

<body>
    <div class="content">
        <div class="topBtn" onclick="window.location = '/admin/receiverMaintenance/'">
            <img src="/images/svg/ArrowBack.svg" alt="">
        </div>

        <div class="toptitle title">
            <%-receiverData[0].fullName%>
        </div>
        <div class="button buttonImage"
            onclick="window.location = '/admin/receiverMaintenance/<%-receiverData[0].id%>/edit/'"><img
                src="/images/svg/edit.svg" alt="">Bearbeiten</div>
                <% if(receiverData[0].blocked==1 || receiverData[0].paid==0 || receiverData[0].activeRegistration==0){%>

                <div class="infoBlock warningBlock">
                    <div class="warningSymbol">
                        <img src="/images/svg/warning.svg" alt="">
                    </div>

                    <div class="infoName">
                    <% if(receiverData[0].blocked==1){%>

                        Blockiert <br>
                    <% }%>
                    <% if(receiverData[0].paid==0){%>
                        Unbezahlt <br>
                        <% }%>
                        <% if(receiverData[0].activeRegistration==0){%>
                            Inaktiv <br>
                            <% }%>


                    </div>
                </div>
                <% }%>

        <div class="infoBlock">

            <div class="infoName">Telefonnummer
            </div>
            <div class="info">
                <%-receiverData[0].phonenumber%>
            </div>
        </div>
        <div class="infoBlock">

            <div class="infoName">Name
            </div>
            <div class="info">
                <%-receiverData[0].fullName%>
            </div>
        </div>
        <div class="infoBlock zemis">

            <div class="infoName">Ausweisnr., Name und Geburtsdatum
            </div>

        </div>
        <div class="infoBlock">

            <div class="infoName">Aufenthaltsstatus
            </div>
            <div class="info">
                <%-receiverData[0].passportType%>
            </div>
        </div>
        <div class="infoBlock">

            <div class="infoName">Geburtsdatum
            </div>
            <div class="info">
                <%-receiverData[0].birthdate%>
            </div>
        </div>
        <div class="infoBlock">

            <div class="infoName">Geschlecht
            </div>
            <div class="info">
                <%-receiverData[0].gender%>
            </div>
        </div>

        <div class="infoBlock">

            <div class="infoName">Familienmitglieder
            </div>
            <div class="info">
                <%-receiverData[0].familyMembers%>

            </div>
        </div>
        
        <div class="infoBlock">

            <div class="infoName">Postleitzahl / Ort
            </div>
            <div class="info">
                <%-receiverData[0].postalCode%>
            </div>
        </div>

        <div class="infoBlock">

            <div class="infoName">Karten-ID
            </div>
            <div class="info">
                <%-receiverData[0].cardId%>
            </div>
        </div>

        <div class="infoBlock">

            <div class="infoName">Timeslot
            </div>
            <div class="info">
                <%-receiverData[0].timeslot%>
            </div>
        </div>
        <div class="infoBlock">

            <div class="infoName">Bezugsberechtigung
            </div>
            <div class="info">
                <%-receiverData[0].entitlement%>
            </div>
        </div>
        <div class="infoBlock">

            <div class="infoName">Registrierungsstandort
            </div>
            <div class="info">
                <% if(receiverData[0].registrationLocation == "gr"){%>
                    Chur GR
                    <%}%>
                    <% if(receiverData[0].registrationLocation == "sz"){%>
                        Seewen SZ
                        <%}%>
            </div>
        </div>
        <div class="infoBlock">

            <div class="infoName">Bemerkungen
            </div>
            <div class="info">
                <%-receiverData[0].comment%>
            </div>
        </div>
        <% if(receiverData[0].paid==0){%>
            <div class="infoBlock false">

                <div class="infoName">Unbezahlt
                </div>
            </div>
            <% }else{%>
                <div class="infoBlock">

                    <div class="infoName"> Bezahlt
                    </div>
                </div>
                <% }%>
        <% if(receiverData[0].blocked==0){%>
            <div class="infoBlock">

                <div class="infoName">Nicht blockiert
                </div>
            </div>
            <% }else{%>
                <div class="infoBlock false" >

                    <div class="infoName"> Blockiert
                    </div>
                </div>
                <% }%>
                    <% if(receiverData[0].activeRegistration==1){%>
                        <div class="infoBlock">

                            <div class="infoName">Aktiv
                            </div>
                        </div>
                        <% }else{%>
                            <div class="infoBlock false">

                                <div class="infoName"> Inaktiv
                                </div>
                            </div>
                            <% }%>
                            <div class="searchContent">
                                <div class="infoBlock">
                                <div class="infoName">Essensbezüge
                                </div>
                            </div>
                                <div class="titleBar"><div class="leftText">Uhrzeit</div><div class="centerSeperator"></div><div class="rightText">Datum</div></div>
                            <% logResults.forEach(function(result) { %>
                                <div class="searchElement"><div class="leftText text"><%-result.logTime%></div><div class="centerSeperator"></div><div class="rightText text"><%-result.date%></div></div>
                            <% }); %> 
                        </div>

    </div>
</body>

</html>
<script>
    var array = <%-zemisData%>
    array.forEach(element => {
        var extra = "";
        if(element.zemisNr == "<%-receiverData[0].passportNumber%>") extra = " permissionElement granted";
        var obj = `<div class="info ${extra}">
                ${element.zemisNr} | ${element.name} | ${element.birthdate} <br><br>
            </div>`;
            $('.zemis').append(obj)
    });
</script>
