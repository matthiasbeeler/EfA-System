<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Essen für Alle</title>
  <link rel="apple-touch-icon" sizes="640x640" href="/images/efaLogo.png">
  <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="manifest" href="/manifest.json">
</head>

<body>
  <div class="content">
    <div class="topBtn" onclick="window.location = '/admin/entry/';">
      <img src="/images/svg/ArrowBack.svg" alt="">
    </div>
    <div class="toptitle title">
      Karte vergessen
    </div>
    <br>
    <div class="entitlement">
      <select name="entitlement" id="entitlement" onchange="$(this).css('border', '2px solid white');"  id="" oninvalid=" $(this).css('border', '2px solid red');" required>
        <option value="" disabled selected>Berechtigung</option>
        <option value="A">A</option>
        <option value="B">B</option>
    </select>
    </div>
    
    <br>
    <br>
    <div class="button buttonImage" onclick="submit()">Eintragen</div>


    <div class="tick">
      <img src="/images/svg/greenTick.svg" alt="">
    </div>
    <br>
  </div>
</body>

</html>
<script src="/javascripts/qr.min.js"></script>
<script>
  $('.message').hide()
  $('.cardScanOverlay').hide()

  function submit(){
    if(!$('#entitlement').val()) {
      $(".button").show();
                $('.message').show()
                return $('.message').html("Bitte Bezugsberechtiung auswählen")
    }
    $('.button').hide()
    $('#entitlement').hide()
        $.ajax({
            url: '/admin/entry/cardForgotten',
            type: 'POST',
            cache: false,
            data: {
              entitlement: $('#entitlement').val()
            },
            success: function (data) {
              console.log(data)
              if (data.success == true) {
                $('.button').hide();
                $('.tick').show();
                setTimeout(() => {
                  $('.tick').hide();
                  $('.button').show();
                  $('#entitlement').show()
                  $(".entitlement").html(`<select name="entitlement" id="entitlement" onchange="$(this).css('border', '2px solid white');"  id="" oninvalid=" $(this).css('border', '2px solid red');" required>
        <option value="" disabled selected>Berechtigung</option>
        <option value="A">A</option>
        <option value="B">B</option>
    </select>`);

                }, 2000);
              }
              if (data.success == false) {
                $(".button").show();
                $('#entitlement').show()
                $('.message').show()
                $('.message').html(data.message)
              }
            },
            error: function (jqXHR, textStatus, err) {
              alert('text status ' + textStatus + ', err ' + err)
              $(".button").show();
              $('#entitlement').show()
            }
          });

        }
</script>