<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Essen für Alle</title>
    <script src="https://code.jquery.com/jquery-1.6.2.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/main.css?v=1">
</head>

<body>
    <div class="content">
        <div class="topBtn" onclick="save()">
            <img src="/images/svg/save.svg" alt="">
        </div>

        <div class="toptitle title">
            <%-result[0].name%>
        </div>
            <div class="button unblockButton buttonImage" onclick="unblock()" style="display: none;"><img src="/images/svg/tick.svg" alt="">Freischalten</div>
        <div class="infoBlock">

            <div class="infoName">Benutzername
            </div>
        <div class="info"><%-result[0].username%></div>
    </div>
    <div class="infoBlock">

<div class="infoName">E-Mail
</div>
<div class="info"><%-result[0].email%></div>
</div>
<div class="infoBlock permissionInfo">

    <div class="infoName">Berechtigungen
    </div>
    <div class="info permissions">
        <div class="permissionElement receiverRegistration" onclick="receiverRegistration()">
            Bezügerregistration
        </div>
        <div class="permissionElement receiverMaintenance" onclick="receiverMaintenance()">
            Bezügerverwaltung
        </div>
        <div class="permissionElement entry" onclick="entry()">
            Eingangskontrolle
        </div>
        <div class="permissionElement statistics" onclick="statistics()">
            Statistik
        </div>
        <div class="permissionElement volunteers" onclick="volunteers()">
            Freiwilligenverwaltung
        </div>
        <div class="permissionElement volunteerCards" onclick="volunteerCards()">
            Freiwilligenkarten
        </div>
        <div class="permissionElement accounts" onclick="accounts()">
            Accountverwaltung
        </div>
        <div class="permissionElement print" onclick="print()">
            Kartendruck
        </div>
        <br>
        <div class="infoName">Standorte
        </div>
        <div class="permissionElement sz" onclick="sz()">
            Schwyz
        </div>
        <div class="permissionElement zh" onclick="zh()">
            Zürich Manegg
        </div>
        <div class="permissionElement gr" onclick="gr()">
            Chur
        </div>
        <div class="permissionElement gl" onclick="gl()">
            Glarus
        </div>
    </div>
    </div>
    <div onclick="resetPassword()" class="button actionButton buttonImage resetBtn"><img src="/images/svg/passwordReset.svg" alt="">Passwort zurücksetzen</div>
        <div class="button unblockButton actionButton buttonImage" style="display: none;" onclick="unblock()"><img src="/images/svg/tick.svg" alt="">Freigeben</div>
            <div class="button blockButton actionButton buttonImage" style="display: none;" onclick="block()"><img src="/images/svg/block.svg" alt="">Sperren</div>
    <div class="button buttonImage" onclick="save()"><img src="/images/svg/save.svg" alt=""> Speichern</div>

</div>
</body>


</html>
<script>
    var permissions = <%-result[0].permissions%>;
    
    if(permissions.receiverRegistration == true) $('.receiverRegistration').addClass('granted')
    if(permissions.receiverMaintenance == true) $('.receiverMaintenance').addClass('granted')
    if(permissions.print == true) $('.print').addClass('granted')
    if(permissions.gr == true) $('.gr').addClass('granted')
    if(permissions.gl == true) $('.gl').addClass('granted')
    if(permissions.sz == true) $('.sz').addClass('granted')
    if(permissions.zh == true) $('.zh').addClass('granted')
    if(permissions.entry == true) $('.entry').addClass('granted')
    if(permissions.accounts == true) $('.accounts').addClass('granted')
    if(permissions.blocked == true) $('.unblockButton').show()
    if(permissions.blocked == false) $('.blockButton').show()
    if(permissions.statistics == true) $('.statistics').addClass('granted')
    if(permissions.volunteers == true) $('.volunteers').addClass('granted')
    if(permissions.volunteerCards == true) $('.volunteerCards').addClass('granted')

    function receiverRegistration(){
        if($('.receiverRegistration').hasClass('granted')) permissions.receiverRegistration = false;
        if($('.receiverRegistration').hasClass('granted')) return $('.receiverRegistration').removeClass('granted');
        if(!$('.receiverRegistration').hasClass('granted')) permissions.receiverRegistration = true;
        if(!$('.receiverRegistration').hasClass('granted')) return $('.receiverRegistration').addClass('granted');
    }
    function volunteers(){
        if($('.volunteers').hasClass('granted')) permissions.volunteers = false;
        if($('.volunteers').hasClass('granted')) return $('.volunteers').removeClass('granted');
        if(!$('.volunteers').hasClass('granted')) permissions.volunteers = true;
        if(!$('.volunteers').hasClass('granted')) return $('.volunteers').addClass('granted');
    }
    function volunteerCards(){
        if($('.volunteerCards').hasClass('granted')) permissions.volunteerCards = false;
        if($('.volunteerCards').hasClass('granted')) return $('.volunteerCards').removeClass('granted');
        if(!$('.volunteerCards').hasClass('granted')) permissions.volunteerCards = true;
        if(!$('.volunteerCards').hasClass('granted')) return $('.volunteerCards').addClass('granted');
    }
    function sz(){
        if($('.sz').hasClass('granted')) permissions.sz = false;
        if($('.sz').hasClass('granted')) return $('.sz').removeClass('granted');
        if(!$('.sz').hasClass('granted')) permissions.sz = true;
        if(!$('.sz').hasClass('granted')) return $('.sz').addClass('granted');
    }
    function gr(){
        if($('.gr').hasClass('granted')) permissions.gr = false;
        if($('.gr').hasClass('granted')) return $('.gr').removeClass('granted');
        if(!$('.gr').hasClass('granted')) permissions.gr = true;
        if(!$('.gr').hasClass('granted')) return $('.gr').addClass('granted');
    }
    function gl(){
        if($('.gl').hasClass('granted')) permissions.gl = false;
        if($('.gl').hasClass('granted')) return $('.gl').removeClass('granted');
        if(!$('.gl').hasClass('granted')) permissions.gl = true;
        if(!$('.gl').hasClass('granted')) return $('.gl').addClass('granted');
    }
    function zh(){
        if($('.zh').hasClass('granted')) permissions.zh = false;
        if($('.zh').hasClass('granted')) return $('.zh').removeClass('granted');
        if(!$('.zh').hasClass('granted')) permissions.zh = true;
        if(!$('.zh').hasClass('granted')) return $('.zh').addClass('granted');
    }
    function print(){
        if($('.print').hasClass('granted')) permissions.print = false;
        if($('.print').hasClass('granted')) return $('.print').removeClass('granted');
        if(!$('.print').hasClass('granted')) permissions.print = true;
        if(!$('.print').hasClass('granted')) return $('.print').addClass('granted');
    }
    function receiverMaintenance(){
        if($('.receiverMaintenance').hasClass('granted')) permissions.receiverMaintenance = false;
        if($('.receiverMaintenance').hasClass('granted')) return $('.receiverMaintenance').removeClass('granted');
        if(!$('.receiverMaintenance').hasClass('granted')) permissions.receiverMaintenance = true;
        if(!$('.receiverMaintenance').hasClass('granted')) return $('.receiverMaintenance').addClass('granted');
    }
    function statistics(){
        if($('.statistics').hasClass('granted')) permissions.statistics = false;
        if($('.statistics').hasClass('granted')) return $('.statistics').removeClass('granted');
        if(!$('.statistics').hasClass('granted')) permissions.statistics = true;
        if(!$('.statistics').hasClass('granted')) return $('.statistics').addClass('granted');
    }
    function entry(){
        if($('.entry').hasClass('granted')) permissions.entry = false;
        if($('.entry').hasClass('granted')) return $('.entry').removeClass('granted');
        if(!$('.entry').hasClass('granted')) permissions.entry = true;
        if(!$('.entry').hasClass('granted')) return $('.entry').addClass('granted');
    }
    function accounts(){
        if($('.accounts').hasClass('granted')) permissions.accounts = false;
        if($('.accounts').hasClass('granted')) return $('.accounts').removeClass('granted');
        if(!$('.accounts').hasClass('granted')) permissions.accounts = true;
        if(!$('.accounts').hasClass('granted')) return $('.accounts').addClass('granted');
    }
    function block(){
        permissions.blocked = true;
        $('.blockButton').hide()
        return $('.unblockButton').show();
    }
    function unblock(){
        permissions.blocked = false;
        $('.unblockButton').hide()
        return $('.blockButton').show();
    }
    $('.message').hide()
    function save(){
        $(".button").hide();
        $.ajax({
            url: '/admin/accounts/save',
            type: 'POST',
            cache: false,
            data: {
                permissions: JSON.stringify(permissions),
                username: "<%-result[0].username%>"
            },
            success: function (data) {
                if (data.success == true) {
                    window.location = "/admin/accounts";
                }
                if (data.success == false) {
                    $(".button").show();
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function (jqXHR, textStatus, err) {
                alert('text status ' + textStatus + ', err ' + err)
                $(".button").show();
            }
        });
    }
    function resetPassword(){
        $(".resetBtn").hide();
        $.ajax({
            url: '/admin/accounts/resetPassword',
            type: 'POST',
            cache: false,
            data: {
                username: "<%-result[0].username%>"
            },
            success: function (data) {
                if (data.success == true) {
                    $('.resetBtn').css('background', "#0A4500")
                    $('.resetBtn').html("E-Mail versendet")
                    $('.resetBtn').attr("onclick", "")
                    $(".resetBtn").show();
                }
                if (data.success == false) {
                    $(".resetBtn").show();
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function (jqXHR, textStatus, err) {
                alert('text status ' + textStatus + ', err ' + err)
                $(".button").show();
            }
        });
    }
</script>